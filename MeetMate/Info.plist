<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>MeetMate transcribes meeting audio locally on your device.</string>
	<key>NSCameraUsageDescription</key>
	<string>MeetMate captures webcam frames alongside screen recording for meeting context.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>MeetMate saves meeting recordings and transcripts to your Documents folder.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>audio</string>
	</array>
</dict>
</plist>
